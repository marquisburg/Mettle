// String comparison, for `==` and `!=` on `string`.
//
// `string` is a borrowed view: a pointer and a length. Comparing two views as
// machine values answers a question nobody asked, because two views of the
// same bytes are equal in the only sense the type has. Before this existed the
// backend compared the 16-byte record as if it were a scalar, and `"ab" ==
// "ab"` was false. That compiled clean and warned about nothing, so
// `if (input == "quit")` was a branch that never ran.
//
// Contents, then, and it matches `+`, which already concatenates contents
// rather than pointers. Equal length and equal bytes: a view with no bytes
// equals another with no bytes whatever either pointer holds.
//
// Written in Mettle for the reason every runtime component should be (V.3.3):
// it reads as source, steps in the same debugger and appears in the same
// profiler. It touches no operating system, so nothing here needs a binding
// that does not exist yet.
//
// A program that never compares strings never names this symbol and never
// links this object.

// Value-to-string conversions, for "{expr}" interpolation. IR lowering picks
// one per interpolated type; a program that never interpolates names none of
// them and links none of this.
//
// Every one of these returns a view whose `chars` is the base of its own
// allocation, so `mettle_string_free` on the view frees exactly what was
// taken. That is what lets lowering free the pieces of an interpolation once
// they have been copied into the next one: a view into the middle of a block
// could not be handed to `free`, and before this the digits were written
// back-to-front into a block whose base nobody kept.

extern fn malloc(size: int64) -> rawptr = "malloc";
extern fn free(block: rawptr) = "free";

// Release the storage behind a view this module produced. IR lowering emits
// this for a string it built and can see the end of, and for nothing else: a
// literal, a slice, and a view a program is still holding are not this
// module's to release.
export fn mettle_string_free(s: string) -> int32 {
    free(s.chars);
    return 0;
}

// Write `value`'s digits at `at` and answer where they end. Shared by every
// conversion here, so none of them builds a number by concatenation.
fn mettle_string_put_uint(buf: uint8*, at: int64, value: uint64) -> int64 {
    var digits: int64 = 1;
    var probe: uint64 = value;
    while (probe >= (uint64)10) {
        probe = probe / (uint64)10;
        digits = digits + 1;
    }
    var i: int64 = at + digits;
    var v: uint64 = value;
    while (i > at) {
        i = i - 1;
        buf[i] = (uint8)(48 + (v % (uint64)10));
        v = v / (uint64)10;
    }
    return at + digits;
}

fn mettle_string_put_text(buf: uint8*, at: int64, text: string) -> int64 {
    var i: int64 = 0;
    var n: int64 = (int64)text.length;
    while (i < n) {
        buf[at + i] = text.chars[i];
        i = i + 1;
    }
    return at + n;
}

// Close a buffer this module filled: NUL for anything that later reads it as a
// C string, and a view whose base is the block itself.
fn mettle_string_own(buf: uint8*, length: int64) -> string {
    buf[length] = (uint8)0;
    var s: string;
    s.chars = buf;
    s.length = (uint64)length;
    return s;
}

fn mettle_string_uint_digits(value: uint64) -> int64 {
    var digits: int64 = 1;
    var probe: uint64 = value;
    while (probe >= (uint64)10) {
        probe = probe / (uint64)10;
        digits = digits + 1;
    }
    return digits;
}

export fn mettle_string_concat(a: string, b: string) -> string {
    var total: int64 = (int64)a.length + (int64)b.length;
    var buf: uint8* = malloc(total + 1);
    var i: int64 = 0;
    var n: int64 = (int64)a.length;
    while (i < n) {
        buf[i] = a.chars[i];
        i = i + 1;
    }
    var j: int64 = 0;
    var m: int64 = (int64)b.length;
    while (j < m) {
        buf[i] = b.chars[j];
        i = i + 1;
        j = j + 1;
    }
    buf[total] = (uint8)0;
    var s: string;
    s.chars = buf;
    s.length = (uint64)total;
    return s;
}

export fn mettle_string_from_uint(value: uint64) -> string {
    var digits: int64 = mettle_string_uint_digits(value);
    var buf: uint8* = malloc(digits + 1);
    return mettle_string_own(buf, mettle_string_put_uint(buf, 0, value));
}

export fn mettle_string_from_int(value: int64) -> string {
    if (value >= 0) {
        return mettle_string_from_uint((uint64)value);
    }
    var magnitude: uint64 = (uint64)0 - (uint64)value;
    var digits: int64 = mettle_string_uint_digits(magnitude);
    var buf: uint8* = malloc(digits + 2);
    buf[0] = (uint8)45;
    return mettle_string_own(buf, mettle_string_put_uint(buf, 1, magnitude));
}

// One character, as a view of one byte. The byte needs a home that outlives
// the view, so it comes from the heap rather than from a stack local the
// escape checker would rightly reject.
export fn mettle_string_from_char(value: int64) -> string {
    var buf: uint8* = malloc(2);
    buf[0] = (uint8)value;
    return mettle_string_own(buf, 1);
}

export fn mettle_string_from_bool(value: int64) -> string {
    if (value != 0) {
        return "true";
    }
    return "false";
}

// Fixed-point rendering with six fractional digits, trailing zeros trimmed to
// at least one. Values at or above 1e17 and positive values below 1e-4 render
// as d.dddddd with a decimal exponent instead, because past those points the
// fixed form is either wider than it is honest or all zeros. Not
// shortest-round-trip; six significant fractional digits is the contract.
fn mettle_string_put_fixed(buf: uint8*, at: int64, value: float64) -> int64 {
    var int_part: int64 = (int64)value;
    var frac: float64 = value - (float64)int_part;
    var scaled: int64 = (int64)(frac * 1000000.0 + 0.5);
    if (scaled >= 1000000) {
        scaled = scaled - 1000000;
        int_part = int_part + 1;
    }
    var next: int64 = mettle_string_put_uint(buf, at, (uint64)int_part);
    buf[next] = (uint8)46;
    next = next + 1;
    var start: int64 = next;
    var scale: int64 = 100000;
    var rest: int64 = scaled;
    while (scale > 0) {
        buf[next] = (uint8)(48 + (rest / scale));
        rest = rest % scale;
        next = next + 1;
        scale = scale / 10;
    }
    while (next > start + 1) {
        if (buf[next - 1] != (uint8)48) {
            break;
        }
        next = next - 1;
    }
    return next;
}

// Takes the raw IEEE-754 bits in a GP register. The call is injected at IR
// lowering with no frontend symbol, so the caller's argument marshaling has no
// declared parameter type to route an XMM value by; bits in an integer
// register need no routing at all.
export fn mettle_string_from_f64(bits: int64) -> string {
    var tmp: int64 = bits;
    var reinterpret: float64* = (float64*)(&tmp);
    var value: float64 = *reinterpret;
    // Sign, eighteen integer digits, a point, six fractional digits, an
    // exponent with its own sign and four digits, and the terminator: the
    // widest thing this writes is half of what it takes.
    var buf: uint8* = malloc(64);
    var at: int64 = 0;
    if (value != value) {
        return mettle_string_own(buf, mettle_string_put_text(buf, 0, "nan"));
    }
    var v: float64 = value;
    if (v < 0.0) {
        buf[at] = (uint8)45;
        at = at + 1;
        v = 0.0 - v;
    }
    // Only zero and infinity survive halving unchanged.
    if (v * 0.5 == v) {
        if (v != 0.0) {
            return mettle_string_own(buf, mettle_string_put_text(buf, at, "inf"));
        }
        return mettle_string_own(buf, mettle_string_put_text(buf, at, "0.0"));
    }
    var upper: float64 = 100000000000000000.0;
    var lower: float64 = 0.0001;
    var exponent: int64 = 0;
    var scaled: bool = false;
    if (v >= upper || v < lower) {
        scaled = true;
        while (v >= 10.0) {
            v = v / 10.0;
            exponent = exponent + 1;
        }
        while (v < 1.0) {
            v = v * 10.0;
            exponent = exponent - 1;
        }
    }
    at = mettle_string_put_fixed(buf, at, v);
    if (scaled) {
        buf[at] = (uint8)101;
        at = at + 1;
        if (exponent < 0) {
            buf[at] = (uint8)45;
            at = at + 1;
            at = mettle_string_put_uint(buf, at, (uint64)(0 - exponent));
        } else {
            at = mettle_string_put_uint(buf, at, (uint64)exponent);
        }
    }
    return mettle_string_own(buf, at);
}

export fn mettle_string_eq(a: string, b: string) -> int32 {
    if (a.length != b.length) {
        return 0;
    }

    var i: int64 = 0;
    var n: int64 = (int64)a.length;
    while (i < n) {
        if (a.chars[i] != b.chars[i]) {
            return 0;
        }
        i = i + 1;
    }

    return 1;
}
