// A machine that does not exist, described in Mettle, compiled to, and run.
//
// Eight registers, six instructions, and a program that computes the tenth
// Fibonacci number. Nothing here is a compiler concept: the registers are an
// ordinary global array, each instruction's meaning is an ordinary function,
// and the encoding is a string. What the compiler contributes is reading the
// description, refusing one that cannot be decoded back, assembling the
// program into those bytes, and running it by calling the semantics functions
// in the compile-time interpreter.
//
//   mettle machine examples/machine/little.mettle
//   mettle emulate examples/machine/little.mettle
import "std/io";
import "std/machine";

var REG: int64[8];

fn ins_seti(a: int64, b: int64, c: int64) -> int64 {
  REG[a] = b;
  return -1;
}

fn ins_add(a: int64, b: int64, c: int64) -> int64 {
  REG[a] = REG[b] + REG[c];
  return -1;
}

fn ins_mov(a: int64, b: int64, c: int64) -> int64 {
  REG[a] = REG[b];
  return -1;
}

fn ins_subi(a: int64, b: int64, c: int64) -> int64 {
  REG[a] = REG[a] - b;
  return -1;
}

fn ins_jnz(a: int64, b: int64, c: int64) -> int64 {
  if (REG[a] != 0) {
    return b;
  }
  return -1;
}

fn ins_out(a: int64, b: int64, c: int64) -> int64 {
  println("r{a} = {REG[a]}");
  return -1;
}

const ISA: MachineInsn[6] = [
  { name: "seti", encoding: "10 %0 %1", operands: 2, reads: "", writes: "%0", semantics: "ins_seti" },
  { name: "add", encoding: "11 %0 %1 %2", operands: 3, reads: "%1,%2", writes: "%0", semantics: "ins_add" },
  { name: "mov", encoding: "12 %0 %1", operands: 2, reads: "%1", writes: "%0", semantics: "ins_mov" },
  { name: "subi", encoding: "13 %0 %1", operands: 2, reads: "%0", writes: "%0", semantics: "ins_subi" },
  { name: "jnz", encoding: "20 %0 %1", operands: 2, reads: "%0", writes: "", semantics: "ins_jnz" },
  { name: "out", encoding: "30 %0", operands: 1, reads: "%0", writes: "", semantics: "ins_out" },
];

const PROGRAM: string[11] = [
  "seti 0, 0",
  "seti 1, 1",
  "seti 2, 10",
  "mov 3, 0",
  "add 0, 0, 1",
  "mov 1, 3",
  "mov 3, 0",
  "subi 2, 1",
  "jnz 2, 3",
  "out 0",
  "out 2",
];

fn main() -> int32 {
  println("this file is a machine, not a program: run `mettle emulate` on it");
  return 0;
}
