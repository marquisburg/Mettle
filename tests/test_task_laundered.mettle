// The capture the analysis cannot see: the frame's address goes into a global
// first, so nothing at the spawn mentions a local. --check-tasks asks the
// machine the same question from the other side and catches it anyway.
import "std/io";
import "std/thread";

struct Work {
  count: int32;
  total: int32;
}

var g_route: Work* = 0;
var g_seen: int32 = 0;

fn worker_main(arg: cstring) -> uint32 {
  var w: Work* = (Work*)arg;
  g_seen = w.count;
  return 0;
}

fn main() -> int32 {
  var work: Work;
  work.count = 21;
  work.total = 0;
  g_route = &work;
  var h: int64 = CreateThread(0, 0, &worker_main, (cstring)g_route, 0, 0);
  thread_join_infinite(h);
  thread_close(h);
  println("seen {g_seen}");
  return 0;
}
