@noinline fn tile_sum(tile: float32 shared*, count: int32) -> float32 {
  var total: float32 = 0.0;
  var i: int32 = 0;
  while (i < count) {
    total = total + tile[i];
    i = i + 1;
  }
  return total;
}

kernel mismatched(rows: float32 global*, out: float32 global*, width: int32) {
  out[block.x] = tile_sum(rows, width);
}
