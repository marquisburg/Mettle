// The same capture, with the task's entry point taken out of a variable and
// out of a struct field rather than written as `&worker_main` at the spawn.
// A task is what the call hands a function value to, however the program got
// hold of that value.
import "std/io";
import "std/thread";

struct Spawn {
  entry: fn(cstring) -> uint32;
  label: int32;
}

struct Work {
  count: int32;
  total: int32;
}

var g_seen: int32 = 0;

fn worker_main(arg: cstring) -> uint32 {
  var w: Work* = (Work*)arg;
  g_seen = w.count;
  return 0;
}

fn spawn_from_variable() -> int64 {
  var work: Work;
  work.count = 7;
  work.total = 0;
  var start: fn(cstring) -> uint32 = &worker_main;
  return CreateThread(0, 0, start, (cstring)(&work), 0, 0);
}

var g_spawn: Spawn;

fn spawn_from_field() -> int64 {
  var work: Work;
  work.count = 9;
  work.total = 0;
  g_spawn.entry = &worker_main;
  g_spawn.label = 1;
  return CreateThread(0, 0, g_spawn.entry, (cstring)(&work), 0, 0);
}

fn main() -> int32 {
  var h: int64 = spawn_from_variable();
  thread_join_infinite(h);
  thread_close(h);
  h = spawn_from_field();
  thread_join_infinite(h);
  thread_close(h);
  println("seen {g_seen}");
  return 0;
}
