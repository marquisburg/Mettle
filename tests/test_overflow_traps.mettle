// A signed add that leaves int64. Without `--check-overflow` it wraps, which
// is what the machine does and what the language has always said. With the
// flag it stops, because a value that wrapped is a value nobody meant.
import "std/io";

fn add(a: int64, b: int64) -> int64 {
  return a + b;
}

fn main() -> int32 {
  var big: int64 = 5000000000000000000;
  println("sum {add(big, big)}");
  return 0;
}
