import "std/mem";

struct Holder { pointer: int64*; count: int64; }
fn read(h: Holder*) -> int32 { return (int32)h->pointer[0]; }

fn main() -> int32 {
  var p: int64* = malloc(64);
  p[0] = 19;
  var h: Holder;
  h.pointer = p;
  h.count = 1;
  var current: int64* = realloc(p, 32);
  if (current == 0) { free(p); return 2; }
  current[0] = 23;
  return read(&h);
}
