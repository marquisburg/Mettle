import "std/mem";

struct Holder { pointer: int64*; count: int64; }
fn keep(p: int64*, depth: int32) -> int64* {
  if (depth == 0) { return p; }
  return keep(p, depth - 1);
}
fn read(p: int64*) -> int64 { return p[0]; }

fn main() -> int32 {
  var p: int64* = calloc(8, 8);
  if (p == 0) { return 2; }
  p[0] = 17;
  p[7] = 25;
  var holder: Holder;
  holder.pointer = keep(p, 3);
  holder.count = 8;
  var copy: Holder = holder;
  memcpy(&holder, &copy, sizeof(Holder));
  var indirect: fn(int64*) -> int64 = &read;
  var first: int64 = indirect(holder.pointer);
  var tail: int64* = &copy.pointer[7];
  var distance: int64 = (int64)tail - (int64)p;
  if (distance != 56) { free(p); return 3; }
  var last: int64 = read(tail);
  free(p);
  return (int32)(first + last);
}
