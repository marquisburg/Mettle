// A program whose answer depends on every argument reaching the right
// parameter. Built twice for aarch64, once with the architecture's own
// argument order and once with a described one that reverses it, the two
// binaries differ and both give 42 under an emulated CPU. That is what says a
// described convention reached the emitted code rather than being printed and
// ignored.
fn weigh(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64) -> int64 {
  return a * 1 + b * 2 + c * 4 + d * 8 + e * 16 + f * 32;
}

fn spread(a: int64, b: int64, c: int64) -> int64 {
  return weigh(a, b, c, a + b, b + c, c - a);
}

fn main() -> int64 {
  var total: int64 = spread(1, 2, 3) - weigh(1, 2, 3, 3, 5, 2);
  return 42 + total;
}
