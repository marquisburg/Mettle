import "std/mem";

@noinline fn scale(dst: int32*, src: int32*, n: int64) {
  var i: int64 = 0;
  while (i < n) {
    dst[i] = src[i] * 3;
    i = i + 1;
  }
}

@noinline fn total(data: int32*, n: int64) -> int64 {
  var sum: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    sum = sum + (int64)data[i];
    i = i + 1;
  }
  return sum;
}

fn main() -> int32 {
  var n: int64 = 64;
  var src: int32* = malloc(n * 4);
  var dst: int32* = malloc(n * 4);
  var i: int64 = 0;
  while (i < n) {
    src[i] = 2;
    i = i + 1;
  }
  scale(dst, src, n);
  var result: int64 = total(dst, n);
  free(src);
  free(dst);
  if (result != 384) { return 1; }
  return 0;
}
