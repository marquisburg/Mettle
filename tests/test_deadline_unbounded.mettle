// A deadline on a function whose longest path cannot be bounded: the loop
// runs until a value the compiler cannot see settles. A deadline that cannot
// be proven is not a deadline, so the build stops and says which half is
// missing.
import "std/io";

var g_limit: int32 = 9;

fn tick(seed: int32) -> int32 where cycles < 4000 {
  var acc: int32 = seed;
  var i: int32 = 0;
  while (i < g_limit) {
    acc = acc + 1;
    i = i + 1;
  }
  return acc;
}

fn main() -> int32 {
  println("total {tick(1)}");
  return 0;
}
