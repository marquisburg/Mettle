import "std/mem";

fn keep(p: int64*) -> int64* { return p; }
fn main() -> int32 {
  var p: int64* = malloc(64);
  p[0] = 19;
  var call: fn(int64*) -> int64* = &keep;
  var stale: int64* = call(p);
  var current: int64* = realloc(p, 32);
  if (current == 0) { free(p); return 2; }
  current[0] = 23;
  return (int32)stale[0];
}
