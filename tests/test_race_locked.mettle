// The same two threads with the same counter, and one effect both writers
// require. Whoever provides FrameLock runs them one at a time, so the two
// writes are ordered by something the program wrote down.
import "std/io";
import "std/thread";

effect Sim;
effect Render;
effect FrameLock;

var g_frame: int32 = 0;
var g_lock: int32 = 0;

fn tick() requires Sim, FrameLock {
  g_frame = g_frame + 1;
}

fn draw() requires Render, FrameLock {
  g_frame = g_frame + 2;
}

fn under_lock_sim() provides FrameLock requires Sim {
  spin_lock(&g_lock);
  tick();
  spin_unlock(&g_lock);
}

fn under_lock_render() provides FrameLock requires Render {
  spin_lock(&g_lock);
  draw();
  spin_unlock(&g_lock);
}

fn sim_main(arg: cstring) -> uint32 provides Sim {
  under_lock_sim();
  return 0;
}

fn render_main(arg: cstring) -> uint32 provides Render {
  under_lock_render();
  return 0;
}

fn main() -> int32 {
  var a: int64 = CreateThread(0, 0, &sim_main, 0, 0, 0);
  var b: int64 = CreateThread(0, 0, &render_main, 0, 0, 0);
  thread_join_infinite(a);
  thread_join_infinite(b);
  thread_close(a);
  thread_close(b);
  println("frame {g_frame}");
  return 0;
}
