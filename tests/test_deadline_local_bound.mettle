// The same loop with its limit held in a binding rather than written as a
// literal at the test. The program set it once before the loop and never
// touches it inside, so the trip count is the same fact spelled differently
// and the deadline is proven the same way.
import "std/io";

fn mix(seed: int32) -> int32 {
  return seed * 3 + 1;
}

fn tick(seed: int32) -> int32 where cycles < 400 {
  var acc: int32 = seed;
  var limit: int32 = 8;
  var i: int32 = 0;
  while (i < limit) {
    acc = mix(acc);
    i = i + 1;
  }
  return acc;
}

fn main() -> int32 {
  println("total {tick(1)}");
  return 0;
}
