// The CPU twin of a launch. `dispatch` inside a `@test` function runs the
// grid in the compiler's own interpreter: index built-ins per work item,
// workgroup storage per block, and barriers cutting the block into phases, so
// what a kernel publishes through a tile is there when the next phase reads it.

kernel vadd(a: float32 global*, b: float32 global*, c: float32 global*, n: int32) {
  var i: int32 = block.x * block_dim.x + thread.x;
  if (i < n) {
    c[i] = a[i] + b[i];
  }
}

kernel tile_reduce(a: float32 global*, out: float32 global*) {
  workgroup var tile: float32[4];
  var lane: int32 = thread.x;
  tile[lane] = a[block.x * 4 + lane];
  barrier(workgroup, acq_rel);
  if (lane == 0) {
    var total: float32 = 0.0;
    var i: int32 = 0;
    while (i < 4) {
      total = total + tile[i];
      i = i + 1;
    }
    out[block.x] = total;
  }
}

@test fn adds_across_two_blocks() -> int32 {
  var a: float32[8];
  var b: float32[8];
  var c: float32[8];
  var i: int32 = 0;
  while (i < 8) {
    a[i] = (float32)i;
    b[i] = 1.0;
    c[i] = 0.0;
    i = i + 1;
  }
  dispatch vadd[grid: (2, 1, 1), block: (4, 1, 1)](
      (float32 global*)&a[0], (float32 global*)&b[0], (float32 global*)&c[0], 8);
  i = 0;
  while (i < 8) {
    if (c[i] != (float32)i + 1.0) { return 1; }
    i = i + 1;
  }
  return 0;
}

@test fn a_tile_is_published_across_the_barrier() -> int32 {
  var a: float32[8];
  var out: float32[2];
  var i: int32 = 0;
  while (i < 8) {
    a[i] = (float32)(i + 1);
    i = i + 1;
  }
  out[0] = 0.0;
  out[1] = 0.0;
  dispatch tile_reduce[grid: (2, 1, 1), block: (4, 1, 1)](
      (float32 global*)&a[0], (float32 global*)&out[0]);
  if (out[0] != 10.0) { return 1; }
  if (out[1] != 26.0) { return 2; }
  return 0;
}
