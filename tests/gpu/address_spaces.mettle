// Address spaces and alignment in the pointer type. Every access in this file
// names the memory it touches, so the emitted PTX has no generic access left.

type Quad = int32 where value % 4 == 0;

@noinline fn quad_sum(row: float32 global align(16)*) -> float32 {
  return row[0] + row[1] + row[2] + row[3];
}

@noinline fn tile_sum(tile: float32 shared*, count: int32) -> float32 {
  var total: float32 = 0.0;
  var i: int32 = 0;
  while (i < count) {
    total = total + tile[i];
    i = i + 1;
  }
  return total;
}

@noinline fn table_lookup(table: float32 constant*, index: int32) -> float32 {
  return table[index];
}

kernel spaced_rows(rows: float32 global align(16)*,
                   table: float32 constant*,
                   out: float32 global*,
                   width: int32) {
  workgroup var tile: float32[64];
  var lane: int32 = thread.x;
  var offset: Quad = (Quad)(lane * 4);
  if (lane < 64) {
    tile[lane] = quad_sum((float32 global align(16)*)&rows[offset]);
  }
  barrier(workgroup, global, acq_rel);
  if (lane == 0) {
    out[block.x] = tile_sum(tile, 64) + table_lookup(table, width);
  }
}
