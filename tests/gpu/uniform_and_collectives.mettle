// Uniformity as a declared type, and the group effects that follow from it.
// `Uniform<T>` is proven, not asserted; a branch on a proven condition is a
// group decision and lowers to bra.uni; a collective is an ordinary function
// carrying `requires Warp`, and a kernel is what provides it.
import "std/warp";

@noinline fn row_total(row: float32 global*, lane: int32) -> float32 requires Warp {
  return warp_sum_f32(row[lane]);
}

kernel row_sums(rows: float32 global*, out: float32 global*, width: int32) {
  var lane: int32 = thread.x;
  var row: Uniform<int32> = (Uniform<int32>)(block.x * 32);
  @uniform! if (block.x < 64) {
    var total: float32 = row_total(&rows[(int32)row], lane);
    if (lane == 0) {
      out[block.x] = total;
    }
  }
  var rounds: Uniform<int32> = (Uniform<int32>)(width / 32);
  var step: int32 = 0;
  while (step < (int32)rounds) {
    out[block.x] = out[block.x] + warp_sum_f32(rows[lane]);
    step = step + 1;
  }
}

@test fn a_uniform_value_is_the_same_in_every_work_item() -> int32 {
  var rows: float32[64];
  var out: float32[2];
  var i: int32 = 0;
  while (i < 64) {
    rows[i] = 1.0;
    i = i + 1;
  }
  out[0] = 0.0;
  out[1] = 0.0;
  dispatch row_sums[grid: (2, 1, 1), block: (32, 1, 1)](
      (float32 global*)&rows[0], (float32 global*)&out[0], 32);
  return 0;
}
