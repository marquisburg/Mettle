import "std/mem";

export struct Site {
  file: string;
  line: int64;
  column: int64;
}

export struct FieldInfo {
  name: string;
  type_name: string;
  offset: int64;
  size: int64;
}

export struct TypeInfo {
  name: string;
  qualified: string;
  module: string;
  site: Site;
  kind: string;
  base: string;
  size: int64;
  align: int64;
  layout: int64;
  fields: FieldInfo[];
  variants: string[];
}

export struct GlobalInfo {
  name: string;
  module: string;
  site: Site;
  type_name: string;
  written_by: string[];
  address_taken: bool;
}

export struct Function {
  name: string;
  qualified: string;
  module: string;
  site: Site;
  callees: string[];
  matches: string[];
  param_types: string[];
  return_type: string;
  is_extern: bool;
  is_exported: bool;
  is_recursive: bool;
  is_address_taken: bool;
  has_indirect_calls: bool;
  is_noalloc: bool;
  is_pure: bool;
  is_inline: bool;
  is_swappable: bool;
  is_kernel: bool;
  effects: string[];
  requires: string[];
  forbids: string[];
  provides: string[];
  allocations: Site[];
  frees: Site[];
  writes_globals: string[];
  returns_pointer: bool;
}

export struct EffectInfo {
  name: string;
  module: string;
  site: Site;
  is_builtin: bool;
}

export struct Program {
  functions: Function[];
  types: TypeInfo[];
  modules: string[];
  effects: EffectInfo[];
  globals: GlobalInfo[];
  target: string;
  file: string;
}

export struct Event {
  kind: string;
  name: string;
  site: Site;
  value: int64;
}

export struct Trace {
  events: Event[];
  test: string;
  file: string;
}

export struct MachineLoop {
  line: int64;
  column: int64;
  vectorized: bool;
  kind: string;
}

export struct MachineFunction {
  name: string;
  file: string;
  line: int64;
  column: int64;
  frame_bytes: int64;
  spills: int64;
  instructions: int64;
  register_allocated: bool;
  inlined_calls: int64;
  calls_left: int64;
  loops: MachineLoop[];
  effects: string[];
}

export struct Machine {
  functions: MachineFunction[];
  target: string;
  file: string;
}

export struct Verdict {
  outcome: int64;
  site: Site;
  message: string;
  fix: string;
}

export fn VERDICT_PASS() -> int64 { return 0; }
export fn VERDICT_FAIL() -> int64 { return 1; }
export fn VERDICT_GAP() -> int64 { return 2; }

export fn verdict_pass() -> Verdict {
  var v: Verdict = { outcome: 0 };
  return v;
}

export fn verdict_fail(site: Site, message: string) -> Verdict {
  var v: Verdict = { outcome: 1, site: site, message: message };
  return v;
}

export fn verdict_fix(site: Site, message: string, replacement: string) -> Verdict {
  var v: Verdict = { outcome: 1, site: site, message: message, fix: replacement };
  return v;
}

export fn verdict_gap(site: Site, message: string) -> Verdict {
  var v: Verdict = { outcome: 2, site: site, message: message };
  return v;
}

export fn verdict_fail_program(message: string) -> Verdict {
  var v: Verdict = { outcome: 1, message: message };
  return v;
}

export fn verdict_gap_program(message: string) -> Verdict {
  var v: Verdict = { outcome: 2, message: message };
  return v;
}

export fn function_calls(f: Function, callee: string) -> bool {
  for c in f.callees {
    if (c == callee) { return true; }
  }
  return false;
}

export fn function_performs(f: Function, effect: string) -> bool {
  for e in f.effects {
    if (e == effect) { return true; }
  }
  return false;
}

export fn function_requires(f: Function, effect: string) -> bool {
  for e in f.requires {
    if (e == effect) { return true; }
  }
  return false;
}

export fn function_forbids(f: Function, effect: string) -> bool {
  for e in f.forbids {
    if (e == effect) { return true; }
  }
  return false;
}

export fn function_provides(f: Function, effect: string) -> bool {
  for e in f.provides {
    if (e == effect) { return true; }
  }
  return false;
}

export fn program_effect_index(p: Program, name: string) -> int64 {
  for i in 0..p.effects.length {
    if (p.effects[i].name == name) { return i; }
  }
  return -1;
}

export fn program_function_index(p: Program, qualified: string) -> int64 {
  for i in 0..p.functions.length {
    if (p.functions[i].qualified == qualified) { return i; }
  }
  return -1;
}

export fn program_type_index(p: Program, qualified: string) -> int64 {
  for i in 0..p.types.length {
    if (p.types[i].qualified == qualified) { return i; }
  }
  return -1;
}

export fn function_reaches(p: Program, from: Function, callee: string) -> bool {
  var count: int64 = p.functions.length;
  var visited: bool[] = new bool[count];
  var stack: int64[] = new int64[count];
  var top: int64 = 0;
  var found: bool = false;
  for c in from.callees {
    if (c == callee) { found = true; }
    var index: int64 = program_function_index(p, c);
    if (index >= 0 && !visited[index]) {
      visited[index] = true;
      stack[top] = index;
      top = top + 1;
    }
  }
  while (top > 0 && !found) {
    top = top - 1;
    var current: int64 = stack[top];
    for c in p.functions[current].callees {
      if (c == callee) { found = true; }
      var index: int64 = program_function_index(p, c);
      if (index >= 0 && !visited[index]) {
        visited[index] = true;
        stack[top] = index;
        top = top + 1;
      }
    }
  }
  free(visited.data);
  free(stack.data);
  return found;
}

export fn function_matches(f: Function, owner: string, variant: string) -> bool {
  for m in f.matches {
    if (m.length != owner.length + 1 + variant.length) { continue; }
    var same: bool = true;
    for i in 0..owner.length {
      if (m[i] != owner[i]) { same = false; }
    }
    if (m[owner.length] != '.') { same = false; }
    for i in 0..variant.length {
      if (m[owner.length + 1 + i] != variant[i]) { same = false; }
    }
    if (same) { return true; }
  }
  return false;
}


export fn function_allocates(f: Function) -> bool {
  return f.allocations.length > 0;
}

export fn function_frees(f: Function) -> bool {
  return f.frees.length > 0;
}

export fn function_writes_global(f: Function, name: string) -> bool {
  for g in f.writes_globals {
    if (g == name) { return true; }
  }
  return false;
}

export fn global_written_by(g: GlobalInfo, function_name: string) -> bool {
  for w in g.written_by {
    if (w == function_name) { return true; }
  }
  return false;
}

export fn program_global_index(p: Program, name: string) -> int64 {
  for i in 0..p.globals.length {
    if (p.globals[i].name == name) { return i; }
  }
  return -1;
}

export fn machine_function_index(m: Machine, name: string) -> int64 {
  for i in 0..m.functions.length {
    if (m.functions[i].name == name) { return i; }
  }
  return -1;
}

export fn machine_site(f: MachineFunction) -> Site {
  var s: Site = { file: f.file, line: f.line, column: f.column };
  return s;
}

export fn machine_loop_site(f: MachineFunction, l: MachineLoop) -> Site {
  var s: Site = { file: f.file, line: l.line, column: l.column };
  return s;
}

export fn machine_all_loops_vectorized(f: MachineFunction) -> bool {
  for l in f.loops {
    if (!l.vectorized) { return false; }
  }
  return true;
}

export fn machine_performs(f: MachineFunction, effect: string) -> bool {
  for e in f.effects {
    if (e == effect) { return true; }
  }
  return false;
}

export fn trace_count(t: Trace, kind: string) -> int64 {
  var n: int64 = 0;
  for e in t.events {
    if (e.kind == kind) { n = n + 1; }
  }
  return n;
}

export fn trace_balanced(t: Trace, opened: string, closed: string) -> bool {
  var depth: int64 = 0;
  for e in t.events {
    if (e.kind == opened) { depth = depth + 1; }
    if (e.kind == closed) { depth = depth - 1; }
    if (depth < 0) { return false; }
  }
  return depth == 0;
}

export fn trace_first(t: Trace, kind: string) -> int64 {
  for i in 0..t.events.length {
    if (t.events[i].kind == kind) { return i; }
  }
  return -1;
}
