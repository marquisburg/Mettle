export struct TargetDesc {
  name: string;
  arch: string;
  os: string;
  format: string;
  pointer_bits: int64;
  stack_alignment: int64;
  shadow_space: int64;
  red_zone: int64;
  int_args: string[16];
  float_args: string[16];
  indirect_return: string;
  separate_classes: bool;
  widths: int64[8];
  vector_width: int64;
  address_spaces: string[8];
  cost_op: int64;
  cost_load: int64;
  cost_store: int64;
  cost_branch: int64;
  cost_multiply: int64;
  cost_multiply_float: int64;
  cost_divide: int64;
  cost_divide_float: int64;
  cost_call: int64;
  cost_allocate: int64;
}
